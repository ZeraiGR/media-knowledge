[Unit]
Description=Isolated restore verification of Media Knowledge metadata
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/libexec/media-knowledge/backup.py verify
TimeoutStartSec=45min
UMask=0077
Nice=15
CPUQuota=50%
MemoryMax=512M
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
